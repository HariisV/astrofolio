---
import Icon from './Icon.astro';
import projects from '../data/projects.json';
import profile from '../data/profile.json';
const LIMIT = 10;
const TYPES = {
  WEB: { tab: 'Web', label: 'Web App' },
  MOBILE: { tab: 'Mobile', label: 'Mobile App' },
} as const;
type ProjectType = keyof typeof TYPES;
const filters = [
  ['All', 'All', projects.length],
  ...Object.entries(TYPES).map(([k, t]) => [k, t.tab, projects.filter((p) => p.type === k).length]),
];
const liveLabel = (url: string) =>
  url.includes('play.google.com')
    ? 'Get it on Google Play'
    : url.includes('apps.apple.com')
      ? 'Download on the App Store'
      : 'Visit live site';
---

<section id="works" class="block" data-projects data-limit={LIMIT}>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="pill">Works</span>
      <h2>Projects</h2>
    </div>
    <div class="rails">
      <div class="proj-bar">
        <h3>
          All Projects <span
            class="mono"
            style="font-size:13px;font-weight:400;color:var(--muted)"
            data-proj-count
            >{String(projects.length).padStart(2, '0')} projects</span>
        </h3>
        <div class="proj-bar__rule"></div>
        <div class="seg" role="group" aria-label="Filter projects">
          {
            filters.map(([k, tab, n], i) => (
              <button
                type="button"
                data-filter={k}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                {tab} ({n})
              </button>
            ))
          }
        </div>
      </div>
      <div class="proj-grid">
        {
          projects.map((p, i) => (
            <article
              class={`card reveal${i === 0 ? ' card--featured' : ''}`}
              data-kind={p.type}
              hidden={i >= LIMIT}
            >
              <div class="card__visual">
                <div class="card__frame card__frame--bare">
                  <img
                    src={`${profile.projectCdn}${p.img}.webp`}
                    alt={p.title}
                    width="800"
                    height="500"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
              <div class="card__body">
                <div class="card__kicker">
                  <>
                    <b data-num>{String(i + 1).padStart(2, '0')}</b>
                    <i />
                    <span>{TYPES[p.type as ProjectType].label}</span>
                  </>
                </div>
                <h4>{p.title}</h4>
                <p class="card__desc">{p.desc}</p>
                {p.wins.map((w) => (
                  <div class="card__win">
                    <Icon name="trend" />
                    <span>{w}</span>
                  </div>
                ))}
                <div class="card__foot">
                  {p.tags.length || !p.live ? (
                    <div class="tags">
                      {p.tags.slice(0, i === 0 ? 5 : 3).map((t) => (
                        <span class="tag">{t}</span>
                      ))}
                    </div>
                  ) : (
                    <a class="card__cta" href={p.live} target="_blank" rel="noopener">
                      <span>{p.cta ?? liveLabel(p.live)}</span>
                      <b><Icon name="arrow" /></b>
                    </a>
                  )}
                  <div style="display:flex;gap:8px;flex-shrink:0">
                    {p.src && (
                      <a
                        class="round"
                        href={p.src}
                        target="_blank"
                        rel="noopener"
                        aria-label="Source code"
                      >
                        <Icon name="code" />
                      </a>
                    )}
                    {p.live && p.tags.length > 0 && (
                      <a
                        class="round round--dark"
                        href={p.live}
                        target="_blank"
                        rel="noopener"
                        aria-label="Live preview"
                      >
                        <Icon name="arrow" />
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <div class="more" hidden={projects.length <= LIMIT}>
        <button class="btn" type="button" data-more
          ><span data-more-label>Show all {projects.length} projects</span>
          <Icon name="chevron" /></button
        >
      </div>
    </div>
  </div>
</section>
