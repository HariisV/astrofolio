---
import Icon from './Icon.astro';
import profile from '../data/profile.json';
const T = profile.techCdn;
const years = new Date().getFullYear() - profile.careerStart;
const orbit = [
  ['react', 0, 28, 20, 11], ['javascript', 90, 28, 20, 11], ['tailwind', 180, 28, 20, 11], ['typescript', 270, 28, 20, 11],
  ['nestjs', 0, 45, 36, 9, 1], ['laravel', 45, 45, 36, 9, 1], ['docker', 90, 45, 36, 9, 1], ['postgresql', 135, 45, 36, 9, 1],
  ['mongodb', 180, 45, 36, 9, 1], ['go', 225, 45, 36, 9, 1], ['aws', 270, 45, 36, 9, 1], ['redis', 315, 45, 36, 9, 1],
] as const;
---
<section id="about" class="hero">
  <div class="hero__dots"></div>
  <div class="wrap hero__grid">
    <div class="intro">
      <div class="intro__top reveal">
        <span class="pill roles">{profile.roles.map(r => <span>{r}</span>)}</span>
      </div>
      <h1 class="intro__name reveal">{profile.name}</h1>
      <p class="intro__lead reveal">Experienced professional with <em><span data-years>{years}</span> {profile.description.split(' ').slice(0, 4).join(' ')}</em> {profile.description.split(' ').slice(4).join(' ')} {profile.tagline}</p>
      <dl class="intro__stats reveal">
        <div><dt><span data-count={years} data-years>{years}</span>+</dt><dd>Years experience</dd></div>
        <div><dt><span data-count={profile.stats.projects}>{profile.stats.projects}</span>+</dt><dd>Projects shipped</dd></div>
        <div><dt><span data-count={profile.stats.rating} data-dec="1">{profile.stats.rating}</span><small>/10</small></dt><dd>Client rating</dd></div>
      </dl>
      <div class="intro__cta reveal">
        <a class="intro__btn" href="#contact"><span>Get in Touch</span><b><Icon name="arrow" /></b></a>
        <a class="intro__icon" href={profile.social.github} target="_blank" rel="noopener" aria-label="GitHub"><Icon name="github" /></a>
        <a class="intro__icon" href={profile.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" /></a>
      </div>
    </div>
    <div class="orbit reveal">
      <div class="orbit__ring" style="width:56cqw;height:56cqw"></div>
      <div class="orbit__ring" style="width:90cqw;height:90cqw;border-color:#E2E8F0"></div>
      <div class="orbit__pulse"></div>
      <div class="orbit__photo"><img src={profile.avatar} alt={profile.name} width="220" height="220" fetchpriority="high" /></div>
      {orbit.map(([n, a, r, dur, w, rev]) => (
        <div class="orbit__item" style={`--a:${a}deg;--r:${r}cqw;--w:${w}cqw;--dur:${dur}s;${rev ? '--dir:reverse;' : ''}`}>
          <img src={`${T}${n}.webp`} alt={n} width="48" height="48" loading="lazy" decoding="async" />
        </div>
      ))}
    </div>
  </div>
</section>
