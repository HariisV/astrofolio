---
import profile from '../data/profile.json';
const T = profile.techCdn;
const floaters = [
  ['react', 'left:4%;top:8%;width:9%', -12, 0], ['tailwind', 'left:30%;top:2%;width:7%', 6, .6], ['nestjs', 'right:30%;top:6%;width:7%', 10, 1.2],
  ['docker', 'right:-7%;top:12%;width:10%', 14, .3], ['typescript', 'left:2%;bottom:16%;width:8%', -8, .9], ['go', 'left:26%;bottom:4%;width:9%', 8, 1.5],
  ['postgresql', 'right:32%;bottom:2%;width:7%', -10, .4], ['laravel', 'right:-5%;bottom:22%;width:8%', 12, 1.1],
] as const;
---
<div class="loader" aria-hidden="true">
  <div class="loader__stage">
    <div class="loader__word"><span>full</span><span class="loader__brace">{'{'}</span><span>stack</span><span class="loader__brace">{'}'}</span><span class="loader__caret"></span></div>
    {floaters.map(([n, pos, r, d]) => (
      <div class="loader__float" style={`${pos};--r:${r}deg;animation-delay:${d}s`}><img src={`${T}${n}.webp`} alt="" width="64" height="64" /></div>
    ))}
    <div class="loader__badge">Software Engineer</div>
    <div class="term">
      <div class="term__bar"><i style="background:#FF5F57"></i><i style="background:#FFBD2E"></i><i style="background:#28C840"></i></div>
      <div class="term__body">
        <div><span style="color:#28C840">$</span> <span class="term__cmd">npm run build</span></div>
        <div class="term__line term__proc">⠋ processing...</div>
        <div class="term__line term__bar2">[<b>████████████</b>]</div>
        <div class="term__line term__ok">✓ compiled successfully</div>
        <div class="term__line term__done">✨ done in 2.7s</div>
      </div>
    </div>
  </div>
  <div class="loader__progress"></div>
</div>
